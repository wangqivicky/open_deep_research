OPENAI_API_KEY=
OPENAI_BASE_URL=h
OPENAI_USE_RESPONSES_API=true
# Generic fallback used for all four model roles. Each role can still be
# overridden with SUMMARIZATION_MODEL, RESEARCH_MODEL, COMPRESSION_MODEL,
# or FINAL_REPORT_MODEL.
MODEL=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
# Optional comma-separated Tavily domain whitelist. Leave empty for web-wide search.
INCLUDE_DOMAINS=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# Research execution limits. Non-empty environment values override the
# corresponding Assistant settings in LangGraph Studio.
MAX_CONCURRENT_RESEARCH_UNITS=2
MAX_CONCURRENT_SUMMARIZATIONS=3
MAX_RESEARCHER_ITERATIONS=5
MAX_REACT_TOOL_CALLS=5
MAX_CONTENT_LENGTH=20000

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false

# Optional final report email delivery. SMTP credentials stay in environment
# variables and are never included in graph state or model prompts.
EMAIL_REPORT_ENABLED=false
EMAIL_REPORT_TO=
EMAIL_REPORT_SUBJECT=Open Deep Research final report
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT=30
